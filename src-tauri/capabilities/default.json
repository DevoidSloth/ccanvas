{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for the app's own webview only (not the web widget's native browser view)",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
